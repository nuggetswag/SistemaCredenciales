<Window x:Class="SistemaCredenciales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaCredenciales"
        mc:Ignorable="d"
        Title="Sistema de Control de Credenciales"
        Icon="/icon.ico"
        Height="740"
        Width="1240"
        MinHeight="600"
        MinWidth="1000"
        FontFamily="Segoe UI"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Background="{StaticResource SidebarBrush}" Grid.Column="0">

            <DockPanel Margin="16,22,16,16">

                <!-- LOGO / TÍTULO -->
                <StackPanel DockPanel.Dock="Top">

                    <Border Background="White"
                            CornerRadius="12"
                            Padding="12,10"
                            HorizontalAlignment="Left">
                        <Grid>
                            <Image x:Name="imgLogo"
                                   Stretch="Uniform"
                                   MaxHeight="46"
                                   MaxWidth="180"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="logoFallback"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1E40AF" HorizontalAlignment="Left" Width="78"><Run Text="CUDE"/><Run Text="C"/></TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="CHUNDEC 2026"
                               FontSize="22"
                               Foreground="White"
                               FontWeight="Bold"
                               Margin="2,14,0,0"/>

                    <TextBlock
                               FontSize="12"
                               Foreground="#94A3B8"><Run Language="es-mx" Text="Derechos reservados Ing. Alexis Rod © "/></TextBlock>

                    <Border Height="1" Background="#334155" Margin="0,18,0,14"/>

                </StackPanel>

                <!-- PIE -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0 · portable"
                           FontSize="11"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"/>

                <!-- NAVEGACIÓN -->
                <StackPanel>
                    <Button Content="🏫   Cargar Escuelas" Style="{StaticResource NavButton}"
                            Margin="0,3" Click="BtnEscuelas_Click"/>
                    <Button Content="📦   Lotes" Style="{StaticResource NavButton}"
                            Margin="0,3" Click="BtnLotes_Click"/>
                    <Button Content="🖊   Entregas" Style="{StaticResource NavButton}"
                            Margin="0,3" Click="BtnEntregas_Click"/>
                    <Button Content="📊   Reportes" Style="{StaticResource NavButton}"
                            Margin="0,3" Click="BtnReportes_Click"/>
                    <Button Content="⚙   Configuración" Style="{StaticResource NavButton}"
                            Margin="0,3" Click="BtnConfiguracion_Click"/>
                </StackPanel>

            </DockPanel>

        </Border>

        <!-- ===================== CONTENIDO ===================== -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Background="White" Grid.Row="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                      Opacity="0.10" Color="#1E293B"/>
                </Border.Effect>

                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Control de Credenciales"
                               Grid.Column="0"
                               FontSize="22"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Escuela:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <ComboBox x:Name="cmbEscuelas"
                                  Width="240"
                                  SelectionChanged="cmbEscuelas_SelectionChanged"/>

                        <Button Content="🗑"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                ToolTip="Quitar la escuela seleccionada"
                                Click="BtnQuitarEscuela_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- DASHBOARD -->
            <Grid Grid.Row="1" Margin="28,24,28,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL -->
                <Button Grid.Column="0" Style="{StaticResource CardButton}"
                        Background="#2563EB" Margin="0,0,8,0"
                        Click="BtnTotal_Click">
                    <StackPanel>
                        <TextBlock Text="📋  TOTAL" Foreground="#DBEAFE"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotal" Text="0" Foreground="White"
                                   FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- ENTREGADAS -->
                <Button Grid.Column="1" Style="{StaticResource CardButton}"
                        Background="#16A34A" Margin="8,0"
                        Click="BtnEntregadas_Click">
                    <StackPanel>
                        <TextBlock Text="✅  ENTREGADAS" Foreground="#DCFCE7"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtEntregadas" Text="0" Foreground="White"
                                   FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- PENDIENTES -->
                <Button Grid.Column="2" Style="{StaticResource CardButton}"
                        Background="#DC2626" Margin="8,0"
                        Click="BtnPendientes_Click">
                    <StackPanel>
                        <TextBlock Text="⏳  PENDIENTES" Foreground="#FEE2E2"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtPendientes" Text="0" Foreground="White"
                                   FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- AVANCE -->
                <Border Grid.Column="3" CornerRadius="16"
                        Background="#7C3AED" Margin="8,0,0,0"
                        Padding="10,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                          Opacity="0.22" Color="#1E293B"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📈  % AVANCE" Foreground="#EDE9FE"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAvance" Text="0%" Foreground="White"
                                   FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- TABLA -->
            <Border Grid.Row="2" Background="White" CornerRadius="16"
                    Margin="28,8,28,24" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                      Opacity="0.12" Color="#1E293B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BARRA DE ACCIONES -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtBuscar"
                                 Grid.Column="0"
                                 Height="38"
                                 MaxWidth="380"
                                 HorizontalAlignment="Left"
                                 GotFocus="txtBuscar_GotFocus"
                                 LostFocus="txtBuscar_LostFocus"
                                 TextChanged="txtBuscar_TextChanged"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="✅  Entregar"
                                    Style="{StaticResource SuccessButton}"
                                    Height="38" MinWidth="130"
                                    Click="BtnEntregar_Click"/>
                            <Button Content="↩  Cancelar entrega"
                                    Style="{StaticResource DangerButton}"
                                    Height="38" MinWidth="170"
                                    Margin="10,0,0,0"
                                    Click="BtnCancelarEntrega_Click"/>
                            <Button Content="🔑  Marcar masivo"
                                    Style="{StaticResource GhostButton}"
                                    Height="38" MinWidth="150"
                                    Margin="10,0,0,0"
                                    ToolTip="Marcar como entregadas (sin firma) — requiere contraseña"
                                    Click="BtnMasivo_Click"/>
                            <Button Content="🧾  Comprobante"
                                    Style="{StaticResource GhostButton}"
                                    Height="38" MinWidth="150"
                                    Margin="10,0,0,0"
                                    ToolTip="Generar comprobante de entrega (PDF) de la credencial seleccionada"
                                    Click="BtnComprobante_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- DATAGRID -->
                    <DataGrid x:Name="dgEscuelas"
                              Grid.Row="1"
                              IsReadOnly="True"
                              MouseDoubleClick="dgEscuelas_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matrícula"
                                Binding="{Binding Matricula}" Width="120"/>
                            <DataGridTextColumn Header="Nombre"
                                Binding="{Binding Nombre}" Width="160"/>
                            <DataGridTextColumn Header="Apellidos"
                                Binding="{Binding Apellidos}" Width="*"/>
                            <DataGridTextColumn Header="Escuela"
                                Binding="{Binding Escuela}" Width="180"/>
                            <DataGridTextColumn Header="Vigencia"
                                Binding="{Binding Vigencia}" Width="110"/>
                            <DataGridTemplateColumn Header="Estado" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="pill" CornerRadius="10"
                                                Padding="10,3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FEE2E2">
                                            <TextBlock x:Name="txtEstado"
                                                       Text="Pendiente"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#B91C1C"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Entregada}" Value="True">
                                                <Setter TargetName="pill" Property="Background" Value="#15803D"/>
                                                <Setter TargetName="txtEstado" Property="Text" Value="Entregada"/>
                                                <Setter TargetName="txtEstado" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="36"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Entregada}" Value="True">
                                        <Setter Property="Background" Value="#86EFAC"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                    </DataGrid>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</Window>
