<Window x:Class="SistemaCredenciales.EntradaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="420"
        ShowInTaskbar="False" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Border Background="White" CornerRadius="16" Margin="18"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.30" Color="#1E293B"/>
        </Border.Effect>
        <StackPanel Margin="26,22">
            <TextBlock x:Name="txtTitulo" Text="Nuevo valor"
                       FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="txtMensaje" Text="" TextWrapping="Wrap"
                       Margin="0,8,0,8" FontSize="13" Foreground="#334155"/>
            <TextBox x:Name="txtValor" Height="38" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}"
                        MinWidth="96" IsCancel="True" Click="BtnCancelar_Click"/>
                <Button Content="Aceptar" MinWidth="96" Margin="10,0,0,0"
                        IsDefault="True" Click="BtnAceptar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
