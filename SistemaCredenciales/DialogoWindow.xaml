<Window x:Class="SistemaCredenciales.DialogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="430"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Border Background="White"
            CornerRadius="16"
            Margin="18"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.30" Color="#1E293B"/>
        </Border.Effect>

        <StackPanel Margin="26,24">

            <StackPanel Orientation="Horizontal">
                <Border x:Name="iconoBg"
                        Width="46" Height="46"
                        CornerRadius="23"
                        Background="#DBEAFE">
                    <TextBlock x:Name="txtIcono"
                               Text="ℹ"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="txtTitulo"
                           Text="Aviso"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           Foreground="#0F172A"/>
            </StackPanel>

            <TextBlock x:Name="txtMensaje"
                       Text=""
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"
                       FontSize="14"
                       Foreground="#334155"/>

            <StackPanel x:Name="panelBotones"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0"/>

        </StackPanel>

    </Border>

</Window>
