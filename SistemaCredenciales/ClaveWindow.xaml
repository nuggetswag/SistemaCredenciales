<Window x:Class="SistemaCredenciales.ClaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="430"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Border Background="White"
            CornerRadius="16"
            Margin="18"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.30" Color="#1E293B"/>
        </Border.Effect>

        <StackPanel Margin="26,24">

            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="#FEF3C7">
                    <TextBlock Text="🔑" FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Acción protegida"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           Foreground="#0F172A"/>
            </StackPanel>

            <TextBlock x:Name="txtMensaje"
                       Text="Escribe la contraseña para continuar."
                       TextWrapping="Wrap"
                       Margin="0,16,0,8"
                       FontSize="14"
                       Foreground="#334155"/>

            <PasswordBox x:Name="pwd"
                         Height="38"
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"/>

            <TextBlock x:Name="lnkOlvide"
                       Text="¿Olvidaste tu contraseña?"
                       Foreground="#2563EB"
                       Background="Transparent"
                       FontSize="12"
                       Cursor="Hand"
                       Margin="2,10,0,0"
                       HorizontalAlignment="Left"
                       TextDecorations="Underline"
                       Visibility="Collapsed"
                       MouseLeftButtonDown="Olvide_Click"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource GhostButton}"
                        MinWidth="96"
                        IsCancel="True"
                        Click="BtnCancelar_Click"/>
                <Button Content="Aceptar"
                        MinWidth="96"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="BtnAceptar_Click"/>
            </StackPanel>

        </StackPanel>

    </Border>

</Window>
