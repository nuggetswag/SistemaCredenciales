<Window x:Class="SistemaCredenciales.CredencialGenerarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar credenciales"
        Icon="/icon.ico"
        Height="680" Width="1020"
        MinHeight="560" MinWidth="900"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎫 Generar credenciales" Style="{StaticResource TituloPantalla}"/>

        <!-- FILTROS (dos filas ordenadas) -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <!-- Fila 1: filtros y acciones -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Escuela:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbEscuela" Width="220" Margin="0,0,18,0"
                          SelectionChanged="Filtro_Changed"/>
                <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cmbCategoria" Width="150" Margin="0,0,18,0"
                          ToolTip="Muestra solo la categoría elegida"
                          SelectionChanged="Filtro_Changed"/>
                <Button Content="🎨 Diseñador" Style="{StaticResource GhostButton}"
                        Height="36" Margin="0,0,10,0" Click="BtnDisenador_Click"/>
                <Button Content="Seleccionar todos" Style="{StaticResource GhostButton}"
                        Height="36" Click="BtnTodos_Click"/>
                <TextBlock x:Name="txtConteo" VerticalAlignment="Center" Margin="18,0,0,0"
                           FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>

            <!-- Fila 2: asignar categoría -->
            <Border Background="#EEF2FF" CornerRadius="10" Padding="10,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Cambiar categoría de las seleccionadas →"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbAsignar" Width="170" Margin="0,0,6,0"
                              ToolTip="Categoría a asignar a las personas seleccionadas"/>
                    <Button Content="➕ Nueva" Style="{StaticResource GhostButton}"
                            Height="36" Margin="0,0,6,0" Click="BtnNuevaCat_Click"/>
                    <Button Content="✔ Aplicar" Style="{StaticResource SuccessButton}"
                            Height="36" Click="BtnAplicarCat_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid x:Name="dgPersonas" Grid.Row="2" Margin="0,14,0,0"
                  IsReadOnly="True" SelectionMode="Extended"
                  SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="120"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="160"/>
                <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="200"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="110"/>
                <DataGridTextColumn Header="Carrera" Binding="{Binding Carrera}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <TextBlock Text="Selecciona personas (o usa 'Seleccionar todos')."
                       Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Content="👁 Vista previa" Style="{StaticResource GhostButton}"
                    Height="40" Width="150" Click="BtnPreview_Click"/>
            <Button Content="📄 PDF individual" Style="{StaticResource PurpleButton}"
                    Height="40" Width="170" Margin="10,0,0,0" Click="BtnIndividual_Click"/>
            <Button Content="🗂 PDF lote (mosaico)"
                    Height="40" Width="200" Margin="10,0,0,0" Click="BtnLote_Click"/>
        </StackPanel>
    </Grid>
</Window>
