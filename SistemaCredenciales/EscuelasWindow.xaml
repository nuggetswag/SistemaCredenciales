<Window x:Class="SistemaCredenciales.EscuelasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escuelas"
        Icon="/icon.ico"
        Height="600"
        Width="900"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="28,24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel>
            <TextBlock Text="🏫  Seleccionar escuela"
                       Style="{StaticResource TituloPantalla}"/>
            <TextBlock Text="Estas son las bases (.mdb) encontradas en tu escritorio. Elige una para verla."
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              Margin="0,18,0,0">

            <WrapPanel x:Name="panelEscuelas"/>

        </ScrollViewer>

    </Grid>

</Window>