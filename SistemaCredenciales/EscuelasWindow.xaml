<Window x:Class="SistemaCredenciales.EscuelasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escuelas"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="SELECCIONAR ESCUELA"
                   FontSize="32"
                   Foreground="White"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto">

            <WrapPanel x:Name="panelEscuelas"
               Margin="0,20,0,0"/>

        </ScrollViewer>

    </Grid>

</Window>