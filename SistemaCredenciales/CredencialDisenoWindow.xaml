<Window x:Class="SistemaCredenciales.CredencialDisenoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diseñador de credenciales"
        Icon="/icon.ico"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="980"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.10" Color="#1E293B"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Categoría:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbTipo" Width="160"
                          ToolTip="Categoría a la que pertenece este diseño"
                          SelectionChanged="Filtro_Changed"/>
                <Button Content="➕ Nueva" Style="{StaticResource GhostButton}"
                        Height="36" Margin="6,0,0,0" Click="BtnNuevaTipo_Click"/>
                <TextBlock Text="Lado:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="cmbLado" Width="120" SelectionChanged="Filtro_Changed"/>
                <Button Content="🖼 Cargar plantilla" Style="{StaticResource GhostButton}"
                        Height="36" Margin="16,0,0,0" Click="BtnPlantilla_Click"/>
                <Button Content="👁 Vista previa" Style="{StaticResource GhostButton}"
                        Height="36" Margin="10,0,0,0" Click="BtnPreview_Click"/>
                <Button Content="💾 Guardar diseño" Style="{StaticResource SuccessButton}"
                        Height="36" Margin="10,0,0,0" Click="BtnGuardar_Click"/>
            </StackPanel>
        </Border>

        <!-- CUERPO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- LIENZO -->
            <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="12" Padding="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="lienzoHost" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Background="White">
                        <Image x:Name="imgPlantilla" Stretch="Fill"/>
                        <Canvas x:Name="lienzo" Background="Transparent"
                                MouseLeftButtonDown="Lienzo_Click"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- PANEL DERECHO -->
            <Border Grid.Column="1" Background="White" CornerRadius="12"
                    Padding="14" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Agregar campo" FontWeight="Bold" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="📷 Foto" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="FOTO" Click="BtnAgregar_Click"/>
                            <Button Content="Nombre completo" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="NOMBRE_COMPLETO" Click="BtnAgregar_Click"/>
                            <Button Content="Nombre" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="NOMBRE" Click="BtnAgregar_Click"/>
                            <Button Content="Apellidos" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="APELLIDOS" Click="BtnAgregar_Click"/>
                            <Button Content="Matrícula" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="MATRICULA" Click="BtnAgregar_Click"/>
                            <Button Content="Carrera" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="CARRERA" Click="BtnAgregar_Click"/>
                            <Button Content="Vigencia" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="VIGENCIA" Click="BtnAgregar_Click"/>
                            <Button Content="Texto libre" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Tag="TEXTO" Click="BtnAgregar_Click"/>
                        </WrapPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,12"/>

                        <TextBlock Text="Propiedades del campo" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel x:Name="panelProps" IsEnabled="False">
                            <TextBlock x:Name="lblCampo" Text="(ninguno seleccionado)"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>

                            <TextBlock Text="Texto (para 'Texto libre')" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtTexto" TextChanged="Prop_Changed"/>

                            <TextBlock Text="Tamaño de letra" Style="{StaticResource Etiqueta}" Margin="0,10,0,5"/>
                            <TextBox x:Name="txtFontSize" TextChanged="Prop_Changed"/>

                            <TextBlock Text="Color (hex, ej. #000000)" Style="{StaticResource Etiqueta}" Margin="0,10,0,5"/>
                            <TextBox x:Name="txtColor" TextChanged="Prop_Changed"/>

                            <TextBlock Text="Alineación" Style="{StaticResource Etiqueta}" Margin="0,10,0,5"/>
                            <ComboBox x:Name="cmbAlign" SelectionChanged="Prop_Changed"/>

                            <CheckBox x:Name="chkBold" Content="Negrita" Margin="0,10,0,0" Click="Prop_Changed"/>

                            <TextBlock Text="Ancho (px)" Style="{StaticResource Etiqueta}" Margin="0,10,0,5"/>
                            <TextBox x:Name="txtAncho" TextChanged="Prop_Changed"/>

                            <TextBlock x:Name="lblAlto" Text="Alto (px) — solo foto" Style="{StaticResource Etiqueta}" Margin="0,10,0,5"/>
                            <TextBox x:Name="txtAlto" TextChanged="Prop_Changed"/>

                            <Button Content="🗑 Eliminar campo" Style="{StaticResource DangerButton}"
                                    Height="36" Margin="0,14,0,0" Click="BtnEliminar_Click"/>
                        </StackPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,12"/>
                        <TextBlock Text="Tip: arrastra los campos sobre la plantilla. El diseño se guarda por Tipo + Lado y sirve para todas las escuelas."
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
