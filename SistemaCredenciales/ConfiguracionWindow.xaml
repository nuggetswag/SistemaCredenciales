<Window x:Class="SistemaCredenciales.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Icon="icon.ico"
        Height="660"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙ Configuración"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1E293B"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,10,12,0">

            <TextBlock Text="Nombre de la institución (para los reportes)"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtInstitucion" Height="38"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Carpeta donde buscar las escuelas (.mdb / .xlsx)"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtBusqueda" Height="38"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="38"
                        Margin="8,0,0,0" Click="BtnBuscarCarpeta_Click" Tag="busqueda"/>
            </Grid>
            <TextBlock Text="Déjala en el escritorio para que funcione en cualquier PC."
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>

            <TextBlock Text="Carpeta de firmas"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFirmas" Height="38"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="38"
                        Margin="8,0,0,0" Click="BtnBuscarCarpeta_Click" Tag="firmas"/>
            </Grid>

            <TextBlock Text="Carpeta de reportes y exportaciones"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtReportes" Height="38"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="38"
                        Margin="8,0,0,0" Click="BtnBuscarCarpeta_Click" Tag="reportes"/>
            </Grid>

            <TextBlock Text="Logo de la institución (aparece en el menú)"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="🖼 Elegir logo..."
                        Style="{StaticResource GhostButton}"
                        Height="38" Width="160"
                        Click="BtnElegirLogo_Click"/>
                <TextBlock x:Name="txtLogoEstado"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <Border Height="1" Background="#E2E8F0" Margin="0,20,0,14"/>

            <TextBlock Text="🔒 Seguridad" FontSize="18" FontWeight="Bold"
                       Foreground="#1E293B" Margin="0,0,0,8"/>

            <TextBlock Text="Correo para códigos de verificación (Gmail)"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtCorreo" Height="38"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Contraseña de aplicación de Gmail"
                       FontWeight="Bold" Margin="0,12,0,4"/>
            <PasswordBox x:Name="pwdApp" Height="38" FontSize="14"
                         Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#E2E8F0" BorderThickness="1"/>
            <TextBlock Text="No es tu contraseña normal de Gmail: es un código que generas en tu cuenta de Google (Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones)."
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="✉ Probar y guardar correo"
                        Style="{StaticResource GhostButton}"
                        Height="38" Width="230"
                        Click="BtnGuardarCorreo_Click"/>
                <TextBlock x:Name="txtCorreoEstado" VerticalAlignment="Center"
                           Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <TextBlock Text="Para CAMBIAR el correo, primero te enviaremos un código al correo actual para confirmar."
                       Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Contraseña (para entrar a Configuración y marcado masivo)"
                       FontWeight="Bold" Margin="0,16,0,4"/>
            <Button Content="🔑 Cambiar contraseña (con código al correo)"
                    Style="{StaticResource GhostButton}"
                    Height="38" Width="340" HorizontalAlignment="Left"
                    Click="BtnCambiarPassword_Click"/>

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Restablecer escritorio"
                    Width="180" Height="42" Margin="0,0,12,0"
                    Click="BtnRestablecer_Click"/>

            <Button Content="💾 GUARDAR"
                    Width="160" Height="42"
                    Background="#16A34A" Foreground="White" FontWeight="Bold"
                    Click="BtnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>
