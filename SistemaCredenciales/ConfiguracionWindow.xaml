<Window x:Class="SistemaCredenciales.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Height="480"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙ Configuración"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1E293B"/>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">

            <TextBlock Text="Nombre de la institución (para los reportes)"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtInstitucion" Height="32"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Carpeta donde buscar las escuelas (.mdb / .xlsx)"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtBusqueda" Height="32"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="32"
                        Margin="8,0,0,0" Click="BtnBuscarCarpeta_Click" Tag="busqueda"/>
            </Grid>
            <TextBlock Text="Déjala en el escritorio para que funcione en cualquier PC."
                       Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>

            <TextBlock Text="Carpeta de firmas"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFirmas" Height="32"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="32"
                        Margin="8,0,0,0" Click="BtnBuscarCarpeta_Click" Tag="firmas"/>
            </Grid>

            <TextBlock Text="Carpeta de reportes y exportaciones"
                       FontWeight="Bold" Margin="0,15,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtReportes" Height="32"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="..." Width="40" Height="32"
                        Margin="8,0,0,0" Click="BtnBuscarCarpeta_Click" Tag="reportes"/>
            </Grid>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Restablecer escritorio"
                    Width="180" Height="42" Margin="0,0,12,0"
                    Click="BtnRestablecer_Click"/>

            <Button Content="💾 GUARDAR"
                    Width="160" Height="42"
                    Background="#16A34A" Foreground="White" FontWeight="Bold"
                    Click="BtnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>
