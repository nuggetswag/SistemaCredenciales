<Window x:Class="SistemaCredenciales.BitacoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bitácora"
        Icon="icon.ico"
        Height="600"
        Width="940"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="📋 Bitácora de acciones"
                       Style="{StaticResource TituloPantalla}"/>
            <TextBlock Text="Registro de acciones importantes (más recientes primero)."
                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgBitacora"
                  Grid.Row="1"
                  Margin="0,16,0,0"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha y hora"
                    Binding="{Binding Fecha}" Width="160"/>
                <DataGridTextColumn Header="Usuario (PC)"
                    Binding="{Binding Usuario}" Width="150"/>
                <DataGridTextColumn Header="Acción"
                    Binding="{Binding Accion}" Width="190"/>
                <DataGridTextColumn Header="Detalle"
                    Binding="{Binding Detalle}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>
